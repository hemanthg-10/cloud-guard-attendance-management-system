# ==========================================
# CLOUD GUARD - Environment Variables Template
# ==========================================
# WARNING: Do NOT put real credentials or secrets in this file.
# Copy this file to '.env' and fill in your actual values.
# The '.env' file is ignored by Git to prevent secrets from leaking.

# --------------------------
# Frontend AWS Configuration
# --------------------------
# API Gateway Invoke URL for your REST API (e.g., https://xxxxxx.execute-api.region.amazonaws.com/prod)
VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.your-region.amazonaws.com/prod

# Amazon Cognito Configuration
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------
# Backend / Lambda Configuration (If applicable for local testing)
# --------------------------
AWS_REGION=us-east-1
DYNAMODB_STUDENTS_TABLE=CloudGuard_Students
DYNAMODB_ATTENDANCE_TABLE=CloudGuard_Attendance
